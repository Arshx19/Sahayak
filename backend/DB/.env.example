# =============================================================================
# SAHAYAK Database Configuration (.env.example)
# Copy this file to .env or include these variables in your root / backend .env
# =============================================================================

# MongoDB Connection String:
# Option A: MongoDB Atlas (Team Cluster - replace <db_username> and <db_password>)
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.rvlg8ic.mongodb.net/?retryWrites=true&w=majority&appName=SahayakCluster"

# Option B: Local MongoDB (offline fallback)
# MONGODB_URI="mongodb://localhost:27017"

# Target Database Name
MONGO_DB_NAME="sahayak"
